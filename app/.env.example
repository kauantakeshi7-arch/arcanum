# Copie este arquivo para .env.local e preencha com os valores reais do seu
# projeto Supabase (Project Settings → API). A anon key é pública por design
# do Supabase — a proteção real é o Row Level Security (RLS) do banco, não o
# sigilo dessa chave (mesmo padrão do config.js usado pela versão atual do app).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA
